---
// Builds one page per case study file in src/content/work/.
// The page address is the file name, e.g. tv-product-cards.mdx → /work/tv-product-cards/
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Media from '../../components/Media.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseItem from '../../components/CaseItem.astro';
import CasePlaceholder from '../../components/CasePlaceholder.astro';
import CaseQuote from '../../components/CaseQuote.astro';
import BillingIADiagram from '../../components/BillingIADiagram.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudyLayout entry={entry} next={next}>
  <Content components={{ CaseSection, CaseItem, CasePlaceholder, CaseQuote, Media, BillingIADiagram }} />
</CaseStudyLayout>
