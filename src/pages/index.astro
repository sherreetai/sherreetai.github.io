---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { EMAIL, LINKEDIN } from '../site';
---

<BaseLayout>
  <section class="mx-auto max-w-[1088px] px-6 pt-20 pb-28 md:pt-28">
    <div data-reveal>
      <h1 class="type-display max-w-[700px]">
        <span class="block text-accent">I’m Sher.</span>
        <span class="block">A product designer focused on turning messy logic into seamless journeys.</span>
      </h1>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={EMAIL} class="action-primary rounded-lg border-2 px-4 py-2.5 text-lg">Email me →</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="action-secondary rounded-lg border-2 px-4 py-2.5 text-lg">Let’s connect on LinkedIn</a>
      </div>

      <hr class="mt-10 border-0 border-t border-ink/20 md:mt-12" />

      <p class="mt-6 max-w-xl text-lg leading-relaxed opacity-70 md:text-xl">
        I design app and web experiences at Virgin Media O2, from account navigation to purchase journeys.
      </p>

      <ul class="mt-8 grid grid-cols-1 gap-6 md:mt-10 md:grid-cols-2 md:gap-10">
        <li class="rounded-lg bg-ink/5 p-4 md:p-6">
          <strong class="block text-lg font-bold text-accent md:text-xl">Evidence first.</strong>
          <span class="mt-4 block text-sm leading-relaxed md:text-lg">
            I start with behavioural data and research, so design decisions have a reason behind them.
          </span>
        </li>
        <li class="rounded-lg bg-ink/5 p-4 md:p-6">
          <strong class="block text-lg font-bold text-accent md:text-xl">Clarity at scale.</strong>
          <span class="mt-4 block text-sm leading-relaxed md:text-lg">
            I simplify complex products into clear journeys, then build design systems that scale across teams.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section id="work" class="pb-24">
    <div class="mx-auto mb-6 max-w-[1088px] px-6">
      <h2 class="type-section-title-prominent" data-reveal><span class="mr-2 inline-block w-12 border-b-4 border-ink align-baseline"></span>Work</h2>
    </div>
    <ProjectGrid />
  </section>
</BaseLayout>
