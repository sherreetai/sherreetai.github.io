---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { EMAIL, LINKEDIN } from '../site';
---

<BaseLayout>
  <section class="mx-auto max-w-[1088px] px-6 pt-12 pb-16 md:pt-14 md:pb-16">
    <div data-reveal>
      <h1 class="type-display max-w-[700px] text-[1.75rem] md:text-[2rem]">
        <span class="block text-accent">I’m Sher Ree.</span>
        <span class="block">
          A product designer focused<br class="hidden md:block" />{' '}
          on turning messy logic into<br class="hidden md:block" />{' '}
          seamless journeys.
        </span>
      </h1>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={EMAIL} class="action-primary rounded-lg border-2 px-3 py-2 text-sm">Email me →</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="action-secondary rounded-lg border-2 px-3 py-2 text-sm">Let’s connect on LinkedIn</a>
      </div>

      <hr class="mt-6 border-0 border-t border-ink/20 md:mt-7" />

      <p class="type-body-large mt-5 font-semibold">
        I design app and web experiences at Virgin Media O2, from account navigation to purchase journeys.
      </p>

      <ul class="mt-7 grid grid-cols-1 gap-y-6 md:grid-cols-3 md:gap-x-6 md:gap-y-0">
        <li class="border-t border-accent pt-4">
          <strong class="flex items-center gap-2 text-base font-bold text-accent uppercase">
            <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19V5m0 14h17M8 15l4-4 3 2 5-6" />
              <path d="M16 7h4v4" />
            </svg>
            Evidence first
          </strong>
          <span class="type-body mt-2 block">
            I start with behavioural data and research so design decisions have a reason behind them.
          </span>
        </li>
        <li class="border-t border-accent pt-4">
          <strong class="flex items-center gap-2 text-base font-bold text-accent uppercase">
            <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 7h18M3 12h12M3 17h8" />
            </svg>
            Clarity over clutter
          </strong>
          <span class="type-body mt-2 block">
            I simplify complex products into journeys people can follow without thinking.
          </span>
        </li>
        <li class="border-t border-accent pt-4">
          <strong class="flex items-center gap-2 text-base font-bold text-accent uppercase">
            <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="8" height="8" rx="1" />
              <rect x="13" y="13" width="8" height="8" rx="1" />
              <path d="M13 7h4a2 2 0 0 1 2 2v4" />
            </svg>
            Built to scale
          </strong>
          <span class="type-body mt-2 block">
            I work in design systems and Figma Variables so solutions hold up across teams.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section id="work" class="pb-24">
    <div class="mx-auto mb-6 max-w-[1088px] px-6">
      <h2 class="type-section-title-prominent" data-reveal><span class="mr-2 inline-block w-12 border-b-4 border-ink align-baseline"></span>Work</h2>
    </div>
    <ProjectGrid />
  </section>
</BaseLayout>
