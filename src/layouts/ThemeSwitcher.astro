---
// "Theme switch me!": the same App Library components shown in each brand theme.
// A toggle under the frame switches between Virgin Media, O2 and Priority.
// Light/dark is not a toggle: it follows the site's own light/dark mode by swapping
// each brand's light and dark image (Priority only has a dark theme, so it uses one image for both).
// Images are cropped PNGs (1477×924 shape) with transparent backgrounds in /public/images/app-library/.
interface Theme {
  id: string;
  label: string;
  light: string;
  dark: string;
  alt: string;
  // darkOnly: the brand has no light theme, so its panel stays dark in light mode too
  darkOnly?: boolean;
}
const base = '/images/app-library/';
const themes: Theme[] = [
  { id: 'vm', label: 'Virgin Media', light: 'vm-light.png', dark: 'vm-dark.png', alt: 'App Library components in the Virgin Media theme: buttons, status chips, notifications, product cards, a header and a map card.' },
  { id: 'o2', label: 'O2', light: 'o2-light.png', dark: 'o2-dark.png', alt: 'The same App Library components in the O2 theme.' },
  { id: 'priority', label: 'Priority', light: 'priority.png', dark: 'priority.png', alt: 'The same App Library components in the Priority theme, which is dark only.', darkOnly: true },
];
---

<figure data-ts class="group m-0">
  <div class="relative aspect-[1477/924] w-full overflow-hidden rounded-lg bg-chip">
    {themes.map((t, i) => (
      <div data-ts-panel={t.id} class:list={['ts-panel absolute inset-0', t.darkOnly && 'bg-panel-dark', i !== 0 && 'opacity-0']} aria-hidden={i !== 0 ? 'true' : undefined}>
        {t.light === t.dark ? (
          <img src={base + t.light} alt={t.alt} loading="lazy" class="block h-full w-full object-contain" />
        ) : (
          <>
            <img src={base + t.light} alt={t.alt} loading="lazy" class="theme-image-light block h-full w-full object-contain" />
            <img src={base + t.dark} alt={t.alt} loading="lazy" class="theme-image-dark h-full w-full object-contain" />
          </>
        )}
      </div>
    ))}
    <!-- Same Expand button as the case-study images: inside the frame, desktop only, appears on hover or keyboard focus -->
    <button
      type="button"
      data-ts-open
      aria-haspopup="dialog"
      aria-label="Expand theme preview"
      class="action-primary absolute top-3 right-3 hidden rounded-full px-3 py-1.5 text-sm font-semibold shadow transition-opacity sm:block sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
    >
      Expand
    </button>
  </div>

  <!-- Brand toggle: real radio buttons, so arrow keys move between brands -->
  <fieldset class="mt-3 flex justify-end">
    <legend class="sr-only">Brand theme</legend>
    <div class="inline-flex rounded-full border border-line p-1">
      {themes.map((t, i) => (
        <label class="cursor-pointer">
          <input type="radio" name="ts-brand" value={t.id} checked={i === 0} class="peer sr-only" />
          <span class="block rounded-full px-3 py-1.5 text-sm font-semibold text-ink transition-colors peer-checked:bg-accent peer-checked:text-background peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">{t.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <dialog data-ts-dialog aria-label="Expanded theme preview" class="m-auto w-[min(96vw,1400px)] max-w-none rounded-xl bg-transparent p-0 backdrop:bg-black/80">
    <div class="rounded-xl bg-background p-3">
      <div class="mb-3 flex justify-end">
        <button type="button" data-ts-close class="action-secondary rounded-full border px-4 py-1.5 text-sm">Close</button>
      </div>
      <div data-ts-dialog-body class="relative mx-auto aspect-[1477/924] max-h-[calc(95vh-5rem)] w-full overflow-hidden rounded-lg bg-chip"></div>
    </div>
  </dialog>
</figure>

<style>
  /* Cross-fade between brands; instant when the reader prefers reduced motion */
  .ts-panel { transition: opacity 300ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .ts-panel { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ts-panel]'));
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const dialog = root.querySelector<HTMLDialogElement>('[data-ts-dialog]');
    const body = root.querySelector<HTMLElement>('[data-ts-dialog-body]');
    const openButton = root.querySelector<HTMLButtonElement>('[data-ts-open]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-ts-close]');

    if (!dialog || !body || !openButton || !closeButton || panels.length === 0) {
      throw new Error('Theme switcher controls are missing.');
    }

    // Give each copy of the switcher its own radio group name
    const group = `ts-brand-${Math.random().toString(36).slice(2, 8)}`;
    radios.forEach((radio) => { radio.name = group; });

    let current = panels[0];
    const show = (id: string) => {
      panels.forEach((panel) => {
        const on = panel.dataset.tsPanel === id;
        panel.classList.toggle('opacity-0', !on);
        if (on) { panel.removeAttribute('aria-hidden'); current = panel; } else { panel.setAttribute('aria-hidden', 'true'); }
      });
    };
    radios.forEach((radio) => radio.addEventListener('change', () => { if (radio.checked) show(radio.value); }));

    // Expand shows the brand you're on, larger
    openButton.addEventListener('click', () => {
      const clone = current.cloneNode(true) as HTMLElement;
      clone.classList.remove('opacity-0');
      body.replaceChildren(clone);
      dialog.showModal();
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
