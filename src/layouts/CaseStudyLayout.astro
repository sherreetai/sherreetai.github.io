---
// The shared case study page: challenge, scope and outcome, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import NextProject from '../components/NextProject.astro';
import CasePlaceholder from '../components/CasePlaceholder.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, summary, role, team, timeline, platform, challenge, heroImage } = entry.data;
const heroIsVideo = heroImage ? /\.(mp4|webm|mov)$/i.test(heroImage) : false;
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-[1088px] px-6 pt-14 pb-10 md:pt-16 md:pb-12" data-reveal>
    <h1 class="type-page-title max-w-[700px]">{title}</h1>
    <p class="type-body-large mt-3 font-semibold">{summary}</p>

    <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 md:mt-10 md:grid-cols-4">
      <div class="border-t border-accent pt-3">
        <dt class="mb-2 text-base font-bold text-accent uppercase">Role</dt>
        <dd>
          <ul class="type-body list-disc space-y-0.5 pl-5">
            {role.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div class="border-t border-accent pt-3">
        <dt class="mb-2 text-base font-bold text-accent uppercase">Team</dt>
        <dd>
          <ul class="type-body list-disc space-y-0.5 pl-5">
            {team.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div class="border-t border-accent pt-3">
        <dt class="mb-2 text-base font-bold text-accent uppercase">Timeline</dt>
        <dd class="type-body">{timeline}</dd>
      </div>
      <div class="border-t border-accent pt-3">
        <dt class="mb-2 text-base font-bold text-accent uppercase">Platform</dt>
        <dd>
          {platform.length > 1 ? (
            <ul class="type-body list-disc space-y-0.5 pl-5">
              {platform.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p class="type-body">{platform[0]}</p>
          )}
        </dd>
      </div>
    </dl>

    <div class="relative mt-10 pt-6 md:mt-12">
      <div class="absolute top-0 left-1/2 w-screen -translate-x-1/2 border-t border-line" aria-hidden="true"></div>
      <h2 class="type-section-title mb-3"><span class="mr-2 text-accent">01</span> Challenge</h2>
      <p class="type-body">{challenge}</p>
    </div>
  </section>

  {heroImage ? (
    heroIsVideo ? (
      <video src={heroImage} controls playsinline class="block h-auto w-full bg-placeholder"></video>
    ) : (
      <img src={heroImage} alt="" class="block h-auto w-full" />
    )
  ) : (
    <CasePlaceholder hero />
  )}

  <article class="case-body pb-12 md:pb-20">
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
    image={next.data.nextImage}
  />
</BaseLayout>
