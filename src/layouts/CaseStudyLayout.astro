
---
// The shared case study page: headline, hero, project details and outcome, the brief, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import NextProject from '../components/NextProject.astro';
import CasePlaceholder from '../components/CasePlaceholder.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import CaseCallout from '../components/CaseCallout.astro';
import CaseSection from '../components/CaseSection.astro';
import VideoPlayer from '../components/VideoPlayer.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, summary, outcome, role, timeline, timelineNote, platform, platformNote, brief, heroImage } = entry.data;
const heroIsVideo = heroImage ? /\.(mp4|webm|mov)$/i.test(heroImage) : false;
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-[1088px] px-6 pt-14 pb-8 md:pt-16 md:pb-10" data-reveal>
    <h1 class="type-page-title max-w-[700px]">{title}</h1>
  </section>

  <!-- Hero image, full width, directly under the headline -->
  {heroImage ? (
    heroIsVideo ? (
      <VideoPlayer src={heroImage} class="block h-auto w-full bg-placeholder" />
    ) : (
      <img src={heroImage} alt="" fetchpriority="high" class="block h-auto w-full" />
    )
  ) : (
    <CasePlaceholder hero />
  )}

  <section class="mx-auto max-w-[1088px] px-6 py-10 md:py-14" data-reveal>
    <div>
      <ProjectMeta
        items={[
          { label: 'Role', values: [role] },
          { label: 'Timeline', values: [timeline], note: timelineNote },
          { label: 'Platform', values: platform, note: platformNote },
        ]}
      />
      <!-- Outcome: the rounded box (accent font), directly under the project details -->
      <div class="mt-8">
        <CaseCallout label="Outcome">{outcome ?? summary}</CaseCallout>
      </div>
    </div>
  </section>

  <article class="case-body">
    <!-- The brief uses the same section component as the rest, so its padding and title spacing match -->
    <CaseSection number="01" title="The brief">
      <p>{brief}</p>
    </CaseSection>
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
  />
</BaseLayout>
