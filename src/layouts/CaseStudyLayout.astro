---
// The shared case study page: tinted intro, hero banner, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Media from '../components/Media.astro';
import NextProject from '../components/NextProject.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, scope, role, outcome, challenge, hero, tint } = entry.data;
---

<BaseLayout title={title} tint={tint}>
  <section class="bg-(--tint)">
    <div class="mx-auto max-w-[1088px] px-6 pt-10 pb-20" data-reveal>
      <h1 class="mb-12 max-w-[850px] text-4xl leading-[1.05] font-bold tracking-tight md:text-[56px]">{title}</h1>

      <dl class="mb-16 grid gap-8 border-y border-ink/15 py-8 md:grid-cols-3 md:gap-12">
        <div>
          <dt class="mb-3 text-xl font-medium">Scope</dt>
          <dd class="text-base leading-relaxed">{scope}</dd>
        </div>
        <div>
          <dt class="mb-3 text-xl font-medium">Role</dt>
          {role.map((r) => <dd class="text-base leading-relaxed">{r}</dd>)}
        </div>
        <div>
          <dt class="mb-3 text-xl font-medium">Outcome</dt>
          <dd class="text-base leading-relaxed">{outcome}</dd>
        </div>
      </dl>

      <div class="max-w-[760px]">
        <h2 class="mb-4 text-2xl font-bold">The Challenge</h2>
        <p class="mb-5 text-lg leading-relaxed">{challenge}</p>
      </div>
    </div>
  </section>

  <Media src={hero} alt={title} layout="bleed" />

  <article class="case-body pb-24">
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
    logo={next.data.logo}
  />
</BaseLayout>
