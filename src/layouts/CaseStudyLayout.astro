
---
// The shared case study page: challenge, scope and outcome, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import NextProject from '../components/NextProject.astro';
import CasePlaceholder from '../components/CasePlaceholder.astro';
import ProjectMeta from '../components/ProjectMeta.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, summary, outcome, role, team, timeline, timelineNote, platform, platformNote, challenge, heroImage } = entry.data;
const heroIsVideo = heroImage ? /\.(mp4|webm|mov)$/i.test(heroImage) : false;
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-[1088px] px-6 pt-14 pb-10 md:pt-16 md:pb-12" data-reveal>
    <h1 class="type-page-title max-w-[700px]">{title}</h1>

    <div class="mt-8 md:mt-10">
      <ProjectMeta
        items={[
          { label: 'Role', values: role },
          { label: 'Team', values: team, separator: ' · ' },
          { label: 'Timeline', values: [timeline], note: timelineNote },
          { label: 'Platform', values: platform, note: platformNote },
          { label: 'Outcome', values: [outcome ?? summary] },
        ]}
      />
    </div>

    <div class="relative mt-10 pt-6 md:mt-12">
      <div class="absolute top-0 left-1/2 w-screen -translate-x-1/2 border-t border-line" aria-hidden="true"></div>
      <!-- Same centred 640px column as the single-column sections below -->
      <div class="mx-auto max-w-[640px]">
        <h2 class="type-section-title mb-5 md:mb-6"><span class="mr-2 text-accent">01</span> Challenge</h2>
        <p class="type-body">{challenge}</p>
      </div>
    </div>
  </section>

  {heroImage ? (
    heroIsVideo ? (
      <video src={heroImage} controls playsinline class="block h-auto w-full bg-placeholder"></video>
    ) : (
      <img src={heroImage} alt="" class="block h-auto w-full" />
    )
  ) : (
    <CasePlaceholder hero />
  )}

  <article class="case-body pb-12 md:pb-20">
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
    image={next.data.nextImage}
  />
</BaseLayout>
