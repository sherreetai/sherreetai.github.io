---
// The shared case study page: tinted intro, hero banner, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Media from '../components/Media.astro';
import NextProject from '../components/NextProject.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, intro, challenge, role, project, year, hero, tint } = entry.data;
const introParagraphs = intro.split(/\n\s*\n/);
---

<BaseLayout title={title} tint={tint}>
  <section class="bg-(--tint)">
    <div class="mx-auto grid max-w-[1088px] gap-12 px-6 pt-10 pb-20 md:grid-cols-[1fr_240px] md:gap-24" data-reveal>
      <div>
        <h1 class="mb-10 text-4xl leading-[1.05] font-bold tracking-tight md:text-[56px]">{title}</h1>
        {introParagraphs.map((p) => <p class="mb-5 text-lg leading-relaxed">{p}</p>)}
        <h2 class="mt-10 mb-4 text-2xl font-bold">The Challenge</h2>
        <p class="text-lg leading-relaxed">{challenge}</p>
      </div>

      <dl class="space-y-10 md:pt-6">
        <div class="border-t border-ink/15 pt-6">
          <dt class="mb-3 text-xl font-medium">Role</dt>
          {role.map((r) => <dd class="text-base">{r}</dd>)}
        </div>
        <div class="border-t border-ink/15 pt-6">
          <dt class="mb-3 text-xl font-medium">Project</dt>
          <dd class="text-base">{project}</dd>
        </div>
        <div class="border-t border-ink/15 pt-6">
          <dt class="mb-3 text-xl font-medium">Year</dt>
          <dd class="text-base">{year}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Media src={hero} alt={title} layout="bleed" />

  <article class="case-body pt-8 pb-24">
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
    logo={next.data.logo}
  />
</BaseLayout>
