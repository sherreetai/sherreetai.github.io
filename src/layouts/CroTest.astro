---
// CRO test, used in "What that evidence changed".
// The banners are recreated in MoversBanner.astro (edit their wording below).
import MoversBanner from './MoversBanner.astro';

const cro = [
  { who: 'Customer with 4x faster speeds', title: 'Up to 4x faster broadband at new address – explore upgrade options after your move' },
  { who: 'Customer who can’t get 4x faster speeds', title: 'Faster broadband speeds at new address – explore upgrade options after your move' },
];
---

<section aria-labelledby="cro-test" class="mt-8">
  <h3 id="cro-test" class="type-label mb-2 text-accent">CRO test</h3>
  <p class="text-sm text-muted">A/B test · next</p>

  <ul class="m-0 mt-4 grid list-none gap-3 p-0">
    {cro.map((c) => (
      <li class="rounded-lg bg-chip p-3">
        <MoversBanner title={c.title} />
        <p class="mt-2 text-sm font-bold text-ink">{c.who}</p>
        <p class="sr-only">Banner: “{c.title}”</p>
      </li>
    ))}
  </ul>

  <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent">
    <li>Copy now points to “after your move”</li>
    <li>One banner for each speed eligibility</li>
  </ul>
  <p class="mt-4"><strong class="text-accent">Measuring:</strong> Movers completion and drop-off, rather than stated preference.</p>
</section>
