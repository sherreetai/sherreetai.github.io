---
// "Simple motion design": the previous static move steps next to the new carousel with motion.
// Same layout as every two-column case study section: copy on the left, visuals on the right, 50/50.
// Before and After sit side by side in one grey frame at their natural shapes.
// Before takes about a third of the width so the After video gets more room.
import VideoPlayer from '../components/VideoPlayer.astro';

const screens = [
  { label: 'Before', note: 'Static steps' },
  { label: 'After', note: 'Carousel with motion' },
];
---

<div class="grid grid-cols-1 items-start gap-8 md:col-span-full md:grid-cols-2 md:gap-x-8">
  <figure class="m-0 order-2">
    <!-- Before and After side by side; the frame fills its column, so it matches the Restructured homepage frame width -->
    <div class="flex w-full items-start justify-center gap-5 rounded-lg border border-line media-panel p-4 md:gap-8 md:p-8">
      {screens.map((s) => (
        <div class:list={['flex min-w-0 flex-col gap-2', s.label === 'Before' ? 'w-[34%] shrink-0' : 'flex-1']}>
          <!-- Label on one line, note on the next, so both visuals start at the same height -->
          <div class="flex flex-col text-sm">
            <span class="font-bold text-ink">{s.label}</span>
            <span class="text-xs whitespace-nowrap text-muted">{s.note}</span>
          </div>
          {s.label === 'Before' ? (
            <img src="/images/vm-home-movers/static-motion.png" alt="Previous move steps: three numbered steps stacked down the page as plain text." width="866" height="1059" loading="lazy" class="block h-auto w-full rounded-lg bg-background shadow-sm" />
          ) : (
            <VideoPlayer src="/images/vm-home-movers/motion.mp4" label="New move steps: a carousel card with an animated icon for each step." controls={false} class="block h-auto w-full rounded-lg bg-background shadow-sm" />
          )}
        </div>
      ))}
    </div>
  </figure>

  <div class="order-1 md:sticky md:top-28">
    <h3 class="type-label mb-2 text-accent">Simple motion design</h3>
    <p>I introduced a carousel and simple motion to make key moments more engaging and break up a long, static page, while keeping the information customers needed within reach.</p>
  </div>
</div>
