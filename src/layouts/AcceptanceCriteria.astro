---
// One 16:9 layout: three Gherkin acceptance-criteria scenarios (Given / When / Then / And).
// Each scenario is a row: its name on the left, the steps on the right with the keyword as a label.
// Inline SVG so it follows the site's colour tokens and dark mode.
// Lines are hand-wrapped to fit, so if you reword a step, keep each line to about 60 characters.

type Clause = { k: string; lines: string[] };
const scenarios: { title: string[]; clauses: Clause[] }[] = [
  {"title": ["Customer views", "the Sky UHD", "proposition"], "clauses": [{"k": "Given", "lines": ["the customer is viewing a TV proposition containing Sky UHD"]}, {"k": "Then", "lines": ["the content should clearly communicate that Sky UHD applies to Sky", "channels only"]}, {"k": "And", "lines": ["the customer should not be led to believe that UHD applies to all", "channels within their package"]}]},
  {"title": ["Customer filters", "TV products", "relevant to UHD"], "clauses": [{"k": "Given", "lines": ["the customer is viewing TV products in the Store"]}, {"k": "When", "lines": ["the customer selects the “<filter>” filter chip"]}, {"k": "Then", "lines": ["products containing relevant Sky UHD content should be displayed"]}, {"k": "And", "lines": ["the UHD proposition should remain discoverable"]}]},
  {"title": ["Customer views", "UHD as part of", "the Store journey"], "clauses": [{"k": "Given", "lines": ["the customer is viewing eligible TV products in the Store"]}, {"k": "When", "lines": ["UHD is available to the customer"]}, {"k": "Then", "lines": ["the UHD proposition should be visible within the Store"]}, {"k": "And", "lines": ["the customer should not need to progress to the Review page to", "discover UHD"]}, {"k": "And", "lines": ["UHD should be presented using the pill button variant"]}]},
];

// Row height from its line counts; stack rows with an 8-unit gap
let rowY = 20;
const rows = scenarios.map((s) => {
  const n = s.clauses.reduce((sum, c) => sum + c.lines.length, 0);
  const h = 18 + n * 15 + (s.clauses.length - 1) * 3;
  let y = rowY + 9 + 12;
  const clauses = s.clauses.map((c) => {
    const out = { ...c, y };
    y += c.lines.length * 15 + 3;
    return out;
  });
  const titleY = rowY + h / 2 - (s.title.length * 16) / 2 + 12;
  const row = { ...s, clauses, y: rowY, h, titleY };
  rowY += h + 8;
  return row;
});
---

<figure data-ac class="group relative m-0">
  <div class="aspect-video w-full overflow-hidden rounded-lg bg-chip">
    <svg viewBox="0 0 640 360" role="group" aria-label="Acceptance criteria: three Gherkin scenarios about showing Sky UHD" class="block h-full w-full">
      {rows.map((r) => (
        <g>
          <rect x="14" y={r.y} width="612" height={r.h} rx="8" stroke-width="1.5" class="fill-background stroke-line" />
          <rect x="20" y={r.y + 6} width="130" height={r.h - 12} rx="6" class="fill-accent" />
          <text x="85" y={r.titleY} font-size="13" font-weight="700" text-anchor="middle" class="fill-background">
            {r.title.map((t, i) => (<tspan x="85" dy={i ? 16 : 0}>{t}</tspan>))}
          </text>
          {r.clauses.map((c) => (
            <g>
              <text x="164" y={c.y} font-size="12" font-weight="700" class="fill-accent">{c.k}</text>
              <text x="206" y={c.y} font-size="12" class="fill-ink">
                {c.lines.map((t, i) => (<tspan x="206" dy={i ? 15 : 0}>{t}</tspan>))}
              </text>
            </g>
          ))}
        </g>
      ))}
    </svg>
  </div>
  <!-- Same Expand button as the case-study images: desktop only, appears on hover or keyboard focus -->
  <button
    type="button"
    data-ac-open
    aria-haspopup="dialog"
    aria-label="Expand acceptance criteria"
    class="action-primary absolute top-3 right-3 hidden rounded-full px-3 py-1.5 text-sm font-semibold shadow transition-opacity sm:block sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
  >
    Expand
  </button>
  <dialog data-ac-dialog aria-label="Expanded acceptance criteria" class="m-auto w-[min(96vw,1400px)] max-w-none rounded-xl bg-transparent p-0 backdrop:bg-black/80">
    <div class="rounded-xl bg-background p-3">
      <div class="mb-3 flex justify-end">
        <button type="button" data-ac-close class="action-secondary rounded-full border px-4 py-1.5 text-sm">Close</button>
      </div>
      <div data-ac-dialog-body class="mx-auto aspect-video max-h-[calc(95vh-5rem)] w-full overflow-hidden rounded-lg bg-chip"></div>
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-ac]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const dialog = root.querySelector<HTMLDialogElement>('[data-ac-dialog]')!;
    const body = root.querySelector<HTMLElement>('[data-ac-dialog-body]')!;
    root.querySelector('[data-ac-open]')!.addEventListener('click', () => {
      body.replaceChildren(svg.cloneNode(true));
      dialog.showModal();
    });
    root.querySelector('[data-ac-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
