---
// A recreated Virgin Media "faster broadband" notification, built as real text so it
// stays readable on mobile and follows dark mode. Used by UserTesting and CroTest.
// Styles:
//   solid:   filled green banner (Option A and the refined versions)
//   outline: green outlined box with a tick (Option B)
//   text:    green text with a lightning bolt (Option C)
interface Props {
  variant?: 'solid' | 'outline' | 'text';
  title: string;
  body?: string;
}
const { variant = 'solid', title, body } = Astro.props;
---

<div class="rounded border border-line bg-background p-2" aria-hidden="true">
  {variant === 'solid' && (
    <p class="m-0 rounded bg-positive px-3 py-2 text-sm leading-snug font-bold text-background">{title}</p>
  )}
  {variant === 'outline' && (
    <div class="flex gap-2 rounded border-2 border-positive px-3 py-2 text-sm leading-snug">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-positive"><path d="m3 8.5 3.25 3L13 4.5"></path></svg>
      <div>
        <p class="m-0 font-bold text-positive">{title}</p>
        {body && <p class="m-0 mt-0.5 text-ink">{body}</p>}
      </div>
    </div>
  )}
  {variant === 'text' && (
    <p class="m-0 flex gap-1.5 px-1 py-1 text-sm leading-snug font-bold text-positive">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 shrink-0"><path d="M9.5 1 3 9h4l-1 6 6.5-8h-4z"></path></svg>
      {title}
    </p>
  )}
</div>
