---
// User testing: Round 1 and Round 2, used in "Validating the evidence".
// Desktop (768px and up): the two rounds sit side by side. Mobile: they stack, Round 1 then Round 2,
// like every other two-column section.
// Real text and bars, so it reflows. Bars are decorative: every number is also written out as text.
// The banners are recreated in MoversBanner.astro (edit their wording below).
import MoversBanner from './MoversBanner.astro';

const round1 = [
  { key: 'A', name: 'Green box', pct: 47, variant: 'solid', title: 'Up to 4x faster broadband available' },
  { key: 'B', name: 'Box + tick', pct: 47, variant: 'outline', title: 'Up to 4x faster broadband available', body: 'Your new address can support faster speeds once your move is complete.' },
  { key: 'C', name: 'Lightning bolt', pct: 5, variant: 'text', title: 'Faster broadband than your current package available at this address' },
] as const;
const clarity = [
  { label: 'rated 5–7', note: '65 of 82', pct: 79, bar: 'bg-accent' },
  { label: 'midpoint (4)', note: '6 of 82', pct: 7, bar: 'bg-muted' },
  { label: 'rated 1–3', note: '11 of 82', pct: 13, bar: 'bg-ink' },
];
const heading = 'type-label mb-2 text-accent';
---

<div class="grid grid-cols-1 gap-10 md:col-span-full md:grid-cols-2 md:gap-8">
  <!-- Round 1 -->
  <section aria-labelledby="ut-r1">
    <h3 id="ut-r1" class={heading}>Round 1</h3>
    <p class="text-sm text-muted">Unmoderated questionnaire · three notification styles · 91 participants</p>
    <ul class="m-0 mt-4 grid list-none gap-3 p-0">
      {round1.map((v) => (
        <li class="rounded-lg bg-chip p-3">
          <MoversBanner variant={v.variant} title={v.title} body={'body' in v ? v.body : undefined} />
          <div class="mt-2 flex items-center gap-3 text-sm">
            <strong class="w-[7.5rem] shrink-0 text-ink">{v.key} · {v.name}</strong>
            <div aria-hidden="true" class="h-3 min-w-0 flex-1 rounded-full bg-background">
              <div class="h-full rounded-full bg-accent" style={`width:${v.pct}%`}></div>
            </div>
            <span class="w-10 shrink-0 text-right font-bold text-ink tabular-nums">{v.pct}%</span>
          </div>
          <p class="sr-only">Option {v.key}: “{v.title}{'body' in v ? ` ${v.body}` : ''}”</p>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-sm text-muted">Final choice overall (A 43, B 43, C 5 participants)</p>
    <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent">
      <li><strong>94%</strong> chose a boxed green notification (A or B)</li>
      <li>A was the most noticeable, B the clearest, C was dropped</li>
    </ul>
  </section>

  <!-- Round 2 -->
  <section aria-labelledby="ut-r2">
    <h3 id="ut-r2" class={heading}>Round 2</h3>
    <p class="text-sm text-muted">Refined and re-tested · 82 participants</p>
    <div class="mt-4 rounded-lg bg-chip p-3">
      <MoversBanner title="Up to 4x faster broadband at new address – you can upgrade once you’ve moved" />
      <p class="mt-2 text-sm font-bold text-ink">Option A’s style with Option B’s explanation</p>
    </div>
    <p class="mt-6 text-5xl leading-none font-bold text-accent tabular-nums">5.27<span class="text-2xl text-ink"> / 7</span></p>
    <p class="mt-1 text-sm text-muted">Next-step clarity, average score</p>
    <div aria-hidden="true" class="mt-3 flex h-4 w-full gap-0.5 overflow-hidden rounded-full bg-chip">
      {clarity.map((c) => (<div class={c.bar} style={`width:${c.pct}%`}></div>))}
    </div>
    <ul class="m-0 mt-3 grid list-none gap-1.5 p-0 text-sm">
      {clarity.map((c) => (
        <li class="flex items-center gap-2">
          <span aria-hidden="true" class={`inline-block size-3 shrink-0 rounded-full ${c.bar}`}></span>
          <span class="text-ink"><strong>{c.pct}%</strong> {c.label} <span class="text-muted">({c.note})</span></span>
        </li>
      ))}
    </ul>
    <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent">
      <li>Availability stayed the main message</li>
      <li>Upgrading was understood as optional</li>
    </ul>
  </section>

  <p class="md:col-span-full"><strong class="text-accent">Decision:</strong> take A forward with B’s context, tighten the timing wording and the nearby “Change package” link, then move to CRO.</p>
</div>
