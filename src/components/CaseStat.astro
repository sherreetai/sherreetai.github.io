---
// A big number with a short label, e.g. "20% average exit rate over 90 days".
// Decorative: the same number should also be written in the copy, so screen readers skip this.
//
// layout:
//   "inline" (default) – number and label on one line
//   "block"            – number above label, with a top rule (for side-by-side comparisons)
// tone:
//   "accent" (default) – purple number (and purple top rule in block layout); use for the headline/winning stat
//   "muted"            – grey number and rule; use for the comparison stat
interface Props {
  value: string;
  label: string;
  layout?: 'inline' | 'block';
  tone?: 'accent' | 'muted';
}
const { value, label, layout = 'inline', tone = 'accent' } = Astro.props;
const numberClass = tone === 'accent' ? 'text-accent' : 'text-muted';
---

{layout === 'inline' ? (
  <p aria-hidden="true" class="m-0 flex items-baseline gap-2">
    <span class:list={['text-4xl leading-none font-bold', numberClass]}>{value}</span>
    <span class="text-sm text-muted">{label}</span>
  </p>
) : (
  <div aria-hidden="true" class:list={['flex flex-col gap-1 border-t-2 pt-3', tone === 'accent' ? 'border-accent' : 'border-line']}>
    <span class:list={['text-4xl leading-none font-bold', numberClass]}>{value}</span>
    <span class="text-sm text-ink">{label}</span>
  </div>
)}
