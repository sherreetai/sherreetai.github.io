---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="rounded-2xl border border-line p-7 md:p-9" data-reveal>
  <h3 class="mb-4 text-xl font-bold tracking-tight">{title}</h3>
  <div class="text-base leading-relaxed [&_p+p]:mt-4">
    <slot />
  </div>
</article>
