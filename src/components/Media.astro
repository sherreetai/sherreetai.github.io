---
import VideoPlayer from './VideoPlayer.astro';
// An image, GIF or video. Videos (.mp4 / .webm / .mov) play muted on a loop with a play/pause button (VideoPlayer.astro).
//
// layout:
//   "plain" (default) – centred, content width
//   "panel"           – sits on a rounded light-grey box
//   "band"            – full-width light-grey strip (e.g. big device mockups)
//   "bleed"           – edge to edge, no padding (used for the hero banner)
interface Props {
  src: string;
  alt?: string;
  layout?: 'plain' | 'panel' | 'band' | 'bleed' | 'card';
  // card layout only: frame shape. '3/2' lines up with 3:2 images and diagrams in the same row
  ratio?: 'video' | '3/2';
}
const { src, alt = '', layout = 'plain', ratio = 'video' } = Astro.props;
const isVideo = /\.(mp4|webm|mov)$/i.test(src);

const outer = {
  plain: 'mx-auto my-16 max-w-[928px] px-6',
  panel: 'mx-auto my-16 max-w-[928px] px-6',
  band: 'my-24 bg-placeholder px-6 py-16',
  bleed: '',
  card: '',
}[layout];

const inner = {
  plain: '',
  panel: 'rounded-lg border border-line bg-placeholder p-6 md:p-12',
  band: 'mx-auto max-w-[1040px]',
  bleed: '',
  card: `${ratio === '3/2' ? 'aspect-[3/2]' : 'aspect-video'} w-full overflow-hidden rounded-lg border border-line bg-background`,
}[layout];
const mediaClass = layout === 'card' ? 'block h-full w-full object-cover' : 'block h-auto w-full';
---

<figure class={outer}>
  <div class={inner}>
    {isVideo ? (
      <VideoPlayer src={src} label={alt} class={mediaClass} wrapperClass={layout === 'card' ? 'h-full w-full' : ''} />
    ) : (
      <img src={src} alt={alt} loading={layout === 'bleed' ? 'eager' : 'lazy'} class={mediaClass} />
    )}
  </div>
</figure>
