---
interface Slide {
  label: string;
  src: string;
  alt: string;
}

interface Props {
  slides: Slide[];
  spacing?: boolean;
}

const { slides, spacing = false } = Astro.props;

if (slides.length === 0) {
  throw new Error('Phone slider requires at least one slide.');
}
---

<figure data-ps class:list={['m-0 mx-auto w-full max-w-[390px]', spacing && 'mt-8']}>
  {slides.map((slide, index) => (
    <div data-ps-panel class="relative" hidden={index !== 0}>
      <div
        data-ps-frame
        tabindex="0"
        role="region"
        aria-label={`${slide.label} screen, scrollable`}
        aria-keyshortcuts="ArrowLeft ArrowRight"
        class="ps-frame aspect-[390/633] w-full overflow-y-auto rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <img src={slide.src} alt={slide.alt} data-ps-src={slide.src} loading={index === 0 ? 'eager' : 'lazy'} class="block h-auto w-full" />
      </div>
      <div
        data-ps-fade
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-20 transition-opacity"
        style="background: linear-gradient(to top, rgb(0 0 0 / 0.22), transparent);"
      >
      </div>
      <div
        data-ps-hint
        aria-hidden="true"
        class="action-primary pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full px-3 py-1.5 text-sm font-semibold shadow transition-opacity"
      >
        Scroll for more ↓
      </div>
    </div>
  ))}

  <div class="mt-3 flex items-center justify-between gap-4 text-sm">
    <span data-ps-count aria-live="polite" aria-atomic="true" class="text-muted">1 / {slides.length} · {slides[0].label}</span>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-ps-prev
        aria-label="Previous product"
        aria-disabled="true"
        class="action-secondary inline-flex size-9 items-center justify-center rounded-full border aria-disabled:pointer-events-none aria-disabled:opacity-40"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>
      </button>
      <button
        type="button"
        data-ps-next
        aria-label="Next product"
        aria-disabled={slides.length === 1 ? 'true' : 'false'}
        class="action-secondary inline-flex size-9 items-center justify-center rounded-full border aria-disabled:pointer-events-none aria-disabled:opacity-40"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg>
      </button>
    </div>
  </div>
</figure>

<style>
  .ps-frame::-webkit-scrollbar { width: 12px; }
  .ps-frame::-webkit-scrollbar-track { background: var(--color-chip); }
  .ps-frame::-webkit-scrollbar-thumb {
    background: var(--color-muted);
    border: 2px solid var(--color-chip);
    border-radius: 6px;
  }
  @supports not selector(::-webkit-scrollbar) {
    .ps-frame { scrollbar-color: var(--color-muted) var(--color-chip); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ps]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ps-panel]'));
    const count = root.querySelector<HTMLElement>('[data-ps-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-ps-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-ps-next]');

    if (!count || !prev || !next || panels.length === 0) {
      throw new Error('Phone slider controls are missing.');
    }

    const frames = panels.map((panel) => {
      const frame = panel.querySelector<HTMLElement>('[data-ps-frame]');
      const fade = panel.querySelector<HTMLElement>('[data-ps-fade]');
      const hint = panel.querySelector<HTMLElement>('[data-ps-hint]');
      const image = frame?.querySelector('img');
      const ariaLabel = frame?.getAttribute('aria-label');

      if (!frame || !fade || !hint || !image || !ariaLabel) {
        throw new Error('Phone slider panel is missing scroll controls.');
      }

      return { frame, fade, hint, image, label: ariaLabel.replace(' screen, scrollable', '') };
    });
    const labels = frames.map(({ label }) => label);
    const behavior: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    let current = 0;

    const update = (index: number) => {
      const { frame, fade, hint } = frames[index];
      const scrollable = frame.scrollHeight > frame.clientHeight + 4;
      const atEnd = frame.scrollTop + frame.clientHeight >= frame.scrollHeight - 4;
      fade.style.opacity = scrollable && !atEnd ? '1' : '0';
      hint.style.opacity = scrollable && frame.scrollTop < 8 ? '1' : '0';
    };

    frames.forEach(({ frame, image }, index) => {
      frame.addEventListener('scroll', () => update(index), { passive: true });
      image.addEventListener('load', () => update(index));
      new ResizeObserver(() => update(index)).observe(frame);
    });

    const select = (index: number, focusFrame = false) => {
      if (index < 0 || index >= panels.length) return;
      current = index;
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      count.textContent = `${index + 1} / ${panels.length} · ${labels[index]}`;
      prev.setAttribute('aria-disabled', String(index === 0));
      next.setAttribute('aria-disabled', String(index === panels.length - 1));
      update(index);
      if (focusFrame) frames[index].frame.focus();
    };

    prev.addEventListener('click', () => select(current - 1));
    next.addEventListener('click', () => select(current + 1));
    frames.forEach(({ frame }) => {
      frame.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' && current < panels.length - 1) {
          event.preventDefault();
          select(current + 1, true);
        }
        if (event.key === 'ArrowLeft' && current > 0) {
          event.preventDefault();
          select(current - 1, true);
        }
      });
    });
    select(0);

    const warm = () => panels.slice(1).forEach((panel) => {
      const image = panel.querySelector<HTMLImageElement>('img');
      if (!image?.dataset.psSrc) throw new Error('Phone slider image is missing its source.');
      const preload = new Image();
      preload.src = image.dataset.psSrc;
    });
    window.setTimeout(warm, 1500);
  });
</script>
