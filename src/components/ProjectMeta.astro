---
// Case study summary (Role, Timeline, Platform, Outcome) under the page title.
// Layout: label/value rows. Desktop (768px and up) = label and value side by side; mobile = label stacked above value.
// The text comes from each case study's settings (role, timeline, platform, plus the optional
// timelineNote and platformNote) via CaseStudyLayout.astro.
interface MetaItem {
  label: string;
  values: string[];
  // Muted secondary detail shown after the values
  note?: string;
  // Joins values. Defaults to ", "
  separator?: string;
}

interface Props {
  items: MetaItem[];
  ariaLabel?: string;
}

const { items, ariaLabel = 'Project details' } = Astro.props;
---

<dl aria-label={ariaLabel} class="m-0">
  {items.map(({ label, values, note, separator = ', ' }) => (
    <div class="grid gap-1 border-b border-line py-3 last:border-b-0 md:grid-cols-[9rem_minmax(0,1fr)] md:items-baseline md:gap-6 md:py-4">
      <dt class="type-label m-0 text-accent">{label}</dt>
      <dd class="m-0 text-sm leading-relaxed">
        {values.join(separator)}
        {note && (
          <>
            <span aria-hidden="true" class="text-muted"> · </span>
            <span class="text-muted">{note}</span>
          </>
        )}
      </dd>
    </div>
  ))}
</dl>
