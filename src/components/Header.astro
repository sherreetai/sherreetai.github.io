---
// Site header: logo on the left, navigation and the light/dark eclipse switch on the right.
// Phones (below 640px): the links move into a full-screen menu opened by the menu (hamburger) button.
// From 640px up: the regular links.
import Logo from './Logo.astro';
import { CV, EMAIL, LINKEDIN } from '../site';

const path = Astro.url.pathname;
const current = path.startsWith('/about') ? 'about' : path === '/' || path.startsWith('/work') ? 'work' : '';
const menuLinks = [
  { label: 'Work', href: '/#work', id: 'work' },
  { label: 'About', href: '/about/', id: 'about' },
];
const textLink = 'link-underline rounded-sm';
---

<header class="sticky top-0 z-50 bg-background">
  <div class="flex items-center justify-between px-5 py-5 sm:px-7 md:px-9">
    <a href="/" aria-label="Home" class="block h-10 w-10">
      <Logo class="h-full w-full" />
    </a>
    <div class="flex items-center gap-3 sm:gap-5 md:gap-7">
      <!-- Regular links (640px and up) -->
      <nav aria-label="Primary" class="hidden items-center gap-5 text-sm sm:flex md:gap-7">
        <a href="/about/" class={textLink}>About</a>
        <a href="/#work" class={textLink}>Work</a>
      </nav>
      <!-- Light/dark switch: an eclipse. Light mode shows a full circle (the sun); in dark mode a shadow slides across it, leaving a crescent -->
      <button id="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" class="eclipse inline-flex h-9 w-9 items-center justify-center rounded-full text-ink hover:bg-chip focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <mask id="eclipse-mask">
            <rect width="24" height="24" fill="white" />
            <circle class="eclipse-shadow" cx="16.5" cy="8" r="6.5" fill="black" />
          </mask>
          <circle class="eclipse-body" cx="12" cy="12" r="7" fill="currentColor" mask="url(#eclipse-mask)" />
        </svg>
      </button>
      <!-- Menu button (phones, below 640px): three lines that turn into an X when open -->
      <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" class="menu-toggle inline-flex h-9 w-9 items-center justify-center rounded-full text-ink hover:bg-chip focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink sm:hidden">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" class="overflow-visible">
          <rect class="menu-bar menu-bar-top" x="2" y="5" width="20" height="2" rx="1" fill="currentColor" />
          <rect class="menu-bar menu-bar-middle" x="2" y="11" width="20" height="2" rx="1" fill="currentColor" />
          <rect class="menu-bar menu-bar-bottom" x="2" y="17" width="20" height="2" rx="1" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Full-screen menu (phones, below 640px). Sits under the header and fades in. -->
  <div id="mobile-menu" data-open="false" class="mobile-menu fixed inset-x-0 top-20 bottom-0 z-40 flex flex-col justify-between overflow-y-auto overscroll-contain bg-background px-5 pt-6 pb-8 sm:hidden">
    <nav aria-label="Menu">
      <ul class="m-0 list-none p-0">
        {menuLinks.map((l, i) => (
          <li class:list={[i > 0 && 'border-t border-line']}>
            <a href={l.href} data-menu-link aria-current={current === l.id ? 'page' : undefined} class="group flex min-h-[72px] items-center gap-4 py-3">
              <span class="link-underline link-underline-thick text-[32px] leading-tight font-bold tracking-tight text-ink">{l.label}</span>
              <svg width="22" height="22" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="ml-auto text-muted transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-10 border-t border-line pt-6">
      <p class="type-label m-0 mb-4 text-muted">Get in touch</p>
      <ul class="m-0 flex list-none flex-col gap-3 p-0 text-base">
        <li>
          <a href={CV} target="_blank" rel="noopener noreferrer" data-menu-link class={`group inline-flex items-center gap-1.5 ${textLink}`}>
            View CV
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M4.5 9.5 9.5 4.5M5 4.5h4.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
        <li><a href={EMAIL} data-menu-link class={textLink}>Email</a></li>
        <li><a href={LINKEDIN} target="_blank" rel="noopener noreferrer" data-menu-link class={textLink}>LinkedIn</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  /* Menu icon: the top and bottom lines rotate into an X, the middle one fades */
  .menu-bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] .menu-bar-top { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-bar-middle { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-bar-bottom { transform: translateY(-6px) rotate(-45deg); }

  /* Menu panel fades in and out */
  .mobile-menu {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }
  .mobile-menu[data-open='true'] {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.25s ease, visibility 0s;
  }

  /* Eclipse: the shadow circle waits off to the top right, then slides across the sun in dark mode.
     Hovering nudges it in slightly, as a hint of what a click will do */
  .eclipse-shadow {
    transform: translate(9px, -9px);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .eclipse:hover .eclipse-shadow {
    transform: translate(4.5px, -4.5px);
  }
  :global(.dark) .eclipse-shadow,
  :global(.dark) .eclipse:hover .eclipse-shadow {
    transform: translate(0, 0);
  }
  .eclipse-body {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  :global(.dark) .eclipse-body {
    transform: rotate(-20deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-bar, .mobile-menu, .eclipse-shadow, .eclipse-body { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    function updateToggle() {
      var isDark = document.documentElement.classList.contains('dark');
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    }

    document.addEventListener('site-theme-change', updateToggle);

    toggle.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      document.documentElement.dataset.themePreference = isDark ? 'dark' : 'light';
      updateToggle();
      try {
        localStorage.setItem('site-theme', isDark ? 'dark' : 'light');
      } catch (error) {
        console.error('Could not save the color theme preference:', error);
      }
    });

    updateToggle();
  })();

  // Mobile menu: open/close, lock page scrolling while open, close on Escape, on a link tap or when widening past 640px
  (function () {
    var button = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;
    var desktop = window.matchMedia('(min-width: 640px)');

    function setOpen(open, returnFocus) {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.dataset.open = String(open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        var first = menu.querySelector('a');
        if (first) first.focus();
      } else if (returnFocus) {
        button.focus();
      }
    }

    button.addEventListener('click', function () {
      setOpen(button.getAttribute('aria-expanded') !== 'true', true);
    });
    menu.querySelectorAll('[data-menu-link]').forEach(function (link) {
      link.addEventListener('click', function () { setOpen(false, false); });
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    desktop.addEventListener('change', function (event) {
      if (event.matches) setOpen(false, false);
    });
  })();
</script>
