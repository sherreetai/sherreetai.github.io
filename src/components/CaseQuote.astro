---
interface Props {
  // column: sit in one grid column (e.g. beside copy) instead of spanning the full width
  column?: boolean;
}

const { column = false } = Astro.props;
const placement = column ? 'self-start' : 'mt-8 md:col-span-full md:mt-10';
---

<blockquote class={`${placement} border-t border-accent pt-4 text-lg leading-relaxed font-bold md:text-xl`}>
  <slot />
</blockquote>
