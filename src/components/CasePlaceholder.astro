---
interface Props {
  hero?: boolean;
  wide?: boolean;
  spacing?: boolean;
  src?: string;
}

const { hero = false, wide = false, spacing = false, src } = Astro.props;
const className = hero
  ? 'aspect-[2/1] min-h-64 max-h-[680px] w-full'
  : wide
    ? 'aspect-[1.8/1] w-full rounded-lg md:col-span-full'
    : 'aspect-[1.4/1] w-full rounded-lg';
const isVideo = src ? /\.(mp4|webm|mov)$/i.test(src) : false;
---

{src ? (
  isVideo ? (
    <video src={src} autoplay muted loop playsinline aria-hidden="true" class:list={[className, spacing && 'mt-8', 'bg-placeholder object-contain']}></video>
  ) : (
    <img src={src} alt="" loading="lazy" class:list={[className, spacing && 'mt-8', 'bg-placeholder object-contain']} />
  )
) : (
  <div class:list={[className, spacing && 'mt-8', 'bg-placeholder']} aria-hidden="true"></div>
)}
