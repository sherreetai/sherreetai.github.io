---
interface Props {
  number: string;
  title: string;
  layout?: 'narrow' | 'two-column' | 'three-column';
}

const { number, title, layout = 'narrow' } = Astro.props;
const contentClass = layout === 'three-column'
  ? 'grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3'
  : layout === 'two-column'
    ? 'grid grid-cols-1 gap-8 md:grid-cols-2'
    : '[&_p+p]:mt-4';
const sectionWidth = layout === 'narrow' ? 'mx-auto max-w-[640px]' : 'mx-auto max-w-[1088px]';
---

<section class="border-t border-line px-6 py-10 md:py-14">
  <div class={sectionWidth}>
    <h2 class="type-section-title mb-5 md:mb-6"><span class="mr-2 text-accent">{number}</span> {title}</h2>
    <div class={`type-body ${contentClass}`}>
      <slot />
    </div>
  </div>
</section>
