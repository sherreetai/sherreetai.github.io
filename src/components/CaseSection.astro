---
interface Props {
  eyebrow: string;
  title: string;
  media?: boolean;
  layout?: 'centered' | 'paired' | 'split';
  divider?: 'right' | 'bottom' | 'right-bottom' | 'none';
}

const { eyebrow, title, media = false, layout, divider } = Astro.props;
const isGridSection = layout !== undefined;
const sectionPadding = divider === 'none' && !isGridSection
  ? 'pt-14 pb-0 md:pt-20'
  : 'py-14 md:py-20';
const pairedDivider = [
  divider === 'none' ? '' : 'border-t border-line',
  divider === 'right' || divider === 'right-bottom' ? 'md:border-r md:border-line' : '',
  divider === 'bottom' || divider === 'right-bottom' ? 'border-b border-line' : '',
].filter(Boolean).join(' ');
const sectionClass = !isGridSection
  ? `relative mx-auto max-w-[1088px] px-6 ${sectionPadding} ${divider === 'none' ? '' : "before:absolute before:inset-x-6 before:top-0 before:border-t before:border-line before:content-['']"}`
  : layout === 'centered'
    ? `px-6 ${divider === 'none' ? 'pt-20 pb-10 md:pt-28 md:pb-14' : 'py-10 md:py-14'} md:col-span-2 md:px-20 ${divider === 'none' ? '' : 'border-t border-line'}`
    : layout === 'split'
      ? `px-6 py-10 md:col-span-2 md:px-12 md:py-14 ${divider === 'none' ? '' : 'border-t border-line'}`
      : `px-6 py-10 md:px-8 md:py-12 ${pairedDivider}`;
const contentClass = layout === 'split'
  ? 'mx-auto grid max-w-[880px] items-center gap-8 md:grid-cols-2'
  : 'mx-auto max-w-[640px]';
---

<section class={sectionClass}>
  <div class={contentClass}>
    <div>
      <p class="mb-2 text-center text-xs font-medium uppercase tracking-wide">{eyebrow}</p>
      <h2 class="mb-6 text-center text-2xl leading-snug font-bold tracking-tight">{title}</h2>
      <div class="text-base leading-relaxed [&_p+p]:mt-4">
        <slot />
      </div>
      {media && layout !== 'split' && <div class="mt-8 aspect-[1.6/1] w-full rounded-lg bg-placeholder" aria-hidden="true"></div>}
    </div>
    {media && layout === 'split' && <div class="aspect-[1.3/1] w-full rounded-lg bg-placeholder md:aspect-[4/3]" aria-hidden="true"></div>}
  </div>
</section>
