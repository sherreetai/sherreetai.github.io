---
// Site footer: a dark ink band with "Get in touch" (Download CV, Email, LinkedIn), matching the phone menu,
// then a small bottom bar with the copyright. The links come from src/site.ts.
import { EMAIL, LINKEDIN, CV } from '../site';

const year = new Date().getFullYear();
const textLink = 'link-underline rounded-sm';
---

<footer class="bg-footer text-white">
  <div class="mx-auto max-w-[1088px] px-6 pt-16 pb-12 md:pt-20 md:pb-14" data-reveal>
    <p class="type-label m-0 mb-4 text-white/60">Get in touch</p>
    <ul class="m-0 flex list-none flex-col gap-3 p-0 text-base sm:flex-row sm:flex-wrap sm:gap-x-8">
      <li>
        <a href={CV} download class={`group inline-flex items-center gap-1.5 ${textLink}`}>
          Download CV
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-y-0.5 motion-reduce:transition-none">
            <path d="M7 2v8M3.5 6.5 7 10l3.5-3.5M3 12.5h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
      <li><a href={EMAIL} class={textLink}>Email</a></li>
      <li><a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class={textLink}>LinkedIn</a></li>
    </ul>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-[1088px] px-6 pt-7 pb-9 text-sm text-white/60">
      <span>© {year} Sher Ree Tai</span>
    </div>
  </div>
</footer>
