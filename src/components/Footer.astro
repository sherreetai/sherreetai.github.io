---
import { EMAIL, LINKEDIN } from '../site';

interface Props {
  full?: boolean; // show the logo beside the contact links
}
const { full = false } = Astro.props;
---

<footer>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-[1088px] items-start justify-between gap-8 px-6 py-10 md:py-14" data-reveal>
      {full && (
        <a href="/" aria-label="Home">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-[9px] font-bold text-white">SR</span>
        </a>
      )}
      <div class={full ? '' : 'ml-auto'}>
        <h2 class="mb-4 text-lg font-medium">Reach out</h2>
        <ul class="space-y-1 text-sm">
          <li><a href={EMAIL} class="underline underline-offset-4 hover:text-accent">Email</a></li>
          <li><a href={LINKEDIN} class="underline underline-offset-4 hover:text-accent">Linkedin</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
