---
interface Props {
  bottomDivider?: boolean;
}

const { bottomDivider = false } = Astro.props;
const gridClass = bottomDivider
  ? "relative mx-auto grid max-w-[1088px] grid-cols-1 px-6 pt-14 before:absolute before:inset-x-6 before:bottom-0 before:border-b before:border-line before:content-[''] md:grid-cols-2 md:pt-20"
  : 'mx-auto grid max-w-[1088px] grid-cols-1 px-6 py-14 md:grid-cols-2 md:py-20';
---

<div class={gridClass}>
  <slot />
</div>
