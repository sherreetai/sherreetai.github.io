---
const titles = ['Structure', 'Exceptions', 'Assignment', 'Apple Watch'];

const down = (x: number, y1: number, y2: number) => `M${x} ${y1}V${y2}M${x - 4} ${y2 - 6}L${x} ${y2}L${x + 4} ${y2 - 6}`;
const right = (y: number, x1: number, x2: number) => `M${x1} ${y}H${x2}M${x2 - 6} ${y - 4}L${x2} ${y}L${x2 - 6} ${y + 4}`;

const accounts = [
  { x: 28, title: 'Custom plan', lines: ['Device + SIM (airtime)', 'Mobile broadband', 'Tablets', 'Non-Apple watches'], pill: '+ up to 3 Apple Watches' },
  { x: 228, title: 'iPhone / iPad', lines: ['Device + SIM (airtime)', 'Sits alone on its', 'billing account'], pill: 'Paid off → SIM only' },
  { x: 428, title: 'SIM only', lines: ['Multiple SIMs share', 'one billing account'], pill: '' },
];

const cards = [
  { x: 28, y: 84, title: 'SIM Free Finance', dash: false, lines: ['A loan, not tied to any plan', 'Sits on its own billing account', 'Several loans can share one account', 'Can merge with a SIM-only account'] },
  { x: 328, y: 84, title: 'Pay as you go', dash: false, lines: ['No Direct Debit', 'Each subscriber opens their own', 'billing account'] },
  { x: 28, y: 212, title: 'Closed account', dash: true, lines: ['No bill and no Direct Debit', 'Visible for up to 3 years', 'Always marked as closed'] },
  { x: 328, y: 212, title: 'Upgrade', dash: false, lines: ['An upgrade stays on the same', 'billing account'] },
];

const rules = ['Plan: sits alone', 'Device on instalment:', 'sits alone', 'SIM only: can share with', 'other SIM-only lines', 'Apple Watch: with its', 'parent iPhone or iPad'];

const cases = [
  { x: 28, title: 'One SIM-only line on the account', step4: ['Watch joins the parent SIM’s', 'billing account'] },
  { x: 328, title: 'Two SIM-only lines on the account', step4: ['System creates a new billing', 'account, bank account and', 'Direct Debit, then moves the', 'parent SIM to the new account'] },
];
const steps123 = ['Customer buys Apple Watches', 'Same bank account as parent', 'Direct Debit setup runs'];
---

<figure data-bia class="m-0">
  <div class="relative aspect-video w-full overflow-hidden rounded-lg bg-chip">
    <div
      data-bia-scroll
      tabindex="0"
      role="region"
      aria-label="Billing information architecture, four slides. Scroll to move through them."
      class="absolute inset-0 snap-y snap-mandatory overflow-y-auto overscroll-contain"
      style="scrollbar-width: thin;"
    >
      <svg viewBox="0 0 640 360" role="group" aria-label="Slide 1 of 4: Structure" class="block aspect-video w-full snap-start bg-chip">
        <text x="28" y="34" font-size="12" font-weight="600" letter-spacing="0.08em" class="fill-accent">01 · STRUCTURE</text>
        <text x="28" y="60" font-size="20" font-weight="700" class="fill-ink">One customer account, several billing accounts</text>
        <rect x="240" y="84" width="160" height="34" rx="8" class="fill-accent" />
        <text x="320" y="106" font-size="13" font-weight="700" text-anchor="middle" class="fill-background">Customer account</text>
        <path d="M320 118V134M120 134H520M120 134V150M320 134V150M520 134V150" fill="none" stroke-width="1.5" class="stroke-muted" />
        {accounts.map((a) => (
          <g>
            <rect x={a.x} y="150" width="184" height="150" rx="8" stroke-width="1.5" class="fill-background stroke-line" />
            <text x={a.x + 12} y="170" font-size="12" letter-spacing="0.06em" class="fill-muted">BILLING ACCOUNT</text>
            <text x={a.x + 12} y="190" font-size="14" font-weight="700" class="fill-ink">{a.title}</text>
            <text x={a.x + 12} y="212" font-size="13" class="fill-ink">
              {a.lines.map((t, i) => (<tspan x={a.x + 12} dy={i ? 18 : 0}>{t}</tspan>))}
            </text>
            {a.pill && (
              <g>
                <rect x={a.x + 12} y="272" width="160" height="22" rx="11" class="fill-chip" />
                <text x={a.x + 92} y="287" font-size="12" text-anchor="middle" class="fill-ink">{a.pill}</text>
              </g>
            )}
          </g>
        ))}
        <text x="28" y="328" font-size="13" class="fill-ink">Billing is returned at billing-account level.</text>
      </svg>

      <svg viewBox="0 0 640 360" role="group" aria-label="Slide 2 of 4: Exceptions" class="block aspect-video w-full snap-start bg-chip">
        <text x="28" y="34" font-size="12" font-weight="600" letter-spacing="0.08em" class="fill-accent">02 · EXCEPTIONS</text>
        <text x="28" y="60" font-size="20" font-weight="700" class="fill-ink">Rules that break a simple hierarchy</text>
        {cards.map((c) => (
          <g>
            <rect x={c.x} y={c.y} width="284" height="116" rx="8" stroke-width="1.5" stroke-dasharray={c.dash ? '5 4' : undefined} class={c.dash ? 'fill-background stroke-muted' : 'fill-background stroke-line'} />
            <text x={c.x + 14} y={c.y + 26} font-size="14" font-weight="700" class="fill-ink">{c.title}</text>
            <text x={c.x + 14} y={c.y + 50} font-size="13" class="fill-ink">
              {c.lines.map((t, i) => (<tspan x={c.x + 14} dy={i ? 18 : 0}>{t}</tspan>))}
            </text>
          </g>
        ))}
      </svg>

      <svg viewBox="0 0 640 360" role="group" aria-label="Slide 3 of 4: Assignment" class="block aspect-video w-full snap-start bg-chip">
        <text x="28" y="34" font-size="12" font-weight="600" letter-spacing="0.08em" class="fill-accent">03 · ASSIGNMENT</text>
        <text x="28" y="60" font-size="20" font-weight="700" class="fill-ink">Where a new product goes</text>
        <g fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-muted">
          <path d={right(112, 198, 235)} />
          <path d={right(112, 405, 442)} />
          <path d={down(320, 134, 176)} />
          <path d={right(198, 405, 442)} />
          <path d={down(320, 220, 262)} />
        </g>
        <rect x="28" y="90" width="170" height="44" rx="8" class="fill-accent" />
        <text x="113" y="117" font-size="13" font-weight="700" text-anchor="middle" class="fill-background">New product in basket</text>
        <rect x="235" y="90" width="170" height="44" rx="8" stroke-width="1.5" class="fill-background stroke-accent" />
        <text x="320" y="109" font-size="13" text-anchor="middle" class="fill-ink"><tspan x="320">Is the selected bank</tspan><tspan x="320" dy="16">account empty?</tspan></text>
        <rect x="442" y="90" width="170" height="44" rx="8" stroke-width="1.5" class="fill-background stroke-muted" />
        <text x="527" y="109" font-size="13" text-anchor="middle" class="fill-ink"><tspan x="527">Assign to a new</tspan><tspan x="527" dy="16">billing account</tspan></text>
        <rect x="235" y="176" width="170" height="44" rx="8" stroke-width="1.5" class="fill-background stroke-accent" />
        <text x="320" y="195" font-size="13" text-anchor="middle" class="fill-ink"><tspan x="320">Compatible with the</tspan><tspan x="320" dy="16">existing products?</tspan></text>
        <rect x="442" y="176" width="170" height="44" rx="8" stroke-width="1.5" class="fill-background stroke-muted" />
        <text x="527" y="195" font-size="13" text-anchor="middle" class="fill-ink"><tspan x="527">Assign to the existing</tspan><tspan x="527" dy="16">billing account</tspan></text>
        <rect x="235" y="262" width="377" height="64" rx="8" stroke-width="1.5" class="fill-background stroke-muted" />
        <text x="423" y="284" font-size="13" text-anchor="middle" class="fill-ink"><tspan x="423">Create a new billing account and bank account</tspan><tspan x="423" dy="16">(same details), set up a Direct Debit and</tspan><tspan x="423" dy="16">assign the product to the new account</tspan></text>
        <g font-size="12" font-weight="700" class="fill-accent">
          <text x="423" y="105" text-anchor="middle">Yes</text>
          <text x="423" y="191" text-anchor="middle">Yes</text>
          <text x="332" y="160">No</text>
          <text x="332" y="246">No</text>
        </g>
        <rect x="28" y="176" width="170" height="150" rx="8" stroke-width="1.5" stroke-dasharray="5 4" class="fill-background stroke-muted" />
        <text x="40" y="198" font-size="12" letter-spacing="0.06em" class="fill-muted">RULES</text>
        <text x="40" y="218" font-size="12" class="fill-ink">
          {rules.map((t, i) => (<tspan x="40" dy={i ? 16 : 0}>{t}</tspan>))}
        </text>
      </svg>

      <svg viewBox="0 0 640 360" role="group" aria-label="Slide 4 of 4: Apple Watch" class="block aspect-video w-full snap-start bg-chip">
        <text x="28" y="34" font-size="12" font-weight="600" letter-spacing="0.08em" class="fill-accent">04 · APPLE WATCH</text>
        <text x="28" y="60" font-size="20" font-weight="700" class="fill-ink">Pairing a watch with its billing account</text>
        {cases.map((c) => (
          <g>
            <rect x={c.x} y="84" width="284" height="210" rx="8" stroke-width="1.5" class="fill-background stroke-line" />
            <text x={c.x + 14} y="110" font-size="14" font-weight="700" class="fill-ink">{c.title}</text>
            {[...steps123, null].map((t, i) => {
              const y = 140 + i * 26;
              return (
                <g>
                  <circle cx={c.x + 24} cy={y - 4} r="9" class="fill-chip" />
                  <text x={c.x + 24} y={y} font-size="12" font-weight="700" text-anchor="middle" class="fill-ink">{i + 1}</text>
                  <text x={c.x + 42} y={y} font-size="13" class="fill-ink">
                    {(t ? [t] : c.step4).map((l, j) => (<tspan x={c.x + 42} dy={j ? 16 : 0}>{l}</tspan>))}
                  </text>
                </g>
              );
            })}
          </g>
        ))}
        <text x="28" y="322" font-size="13" class="fill-ink">Up to 3 cellular watches per account, one active at a time.</text>
      </svg>
    </div>
  </div>

  <figcaption class="mt-3 flex items-center justify-between gap-4 text-sm">
    <span data-bia-count class="text-muted" aria-live="polite">1 / 4 · {titles[0]}. Scroll to explore.</span>
    <button type="button" data-bia-open class="action-secondary rounded-full border px-4 py-1.5 text-sm">Expand</button>
  </figcaption>

  <dialog data-bia-dialog aria-label="Billing information architecture, expanded" class="m-auto w-[min(96vw,1100px)] rounded-xl bg-background p-4 text-ink backdrop:bg-black/60">
    <div class="mb-3 flex justify-end">
      <button type="button" data-bia-close class="action-secondary rounded-full border px-4 py-1.5 text-sm">Close</button>
    </div>
    <div data-bia-dialog-body class="relative aspect-video w-full overflow-hidden rounded-lg bg-chip"></div>
  </dialog>
</figure>

<script>
  const titles = ['Structure', 'Exceptions', 'Assignment', 'Apple Watch'];

  document.querySelectorAll<HTMLElement>('[data-bia]').forEach((root) => {
    const scroller = root.querySelector<HTMLElement>('[data-bia-scroll]');
    const count = root.querySelector<HTMLElement>('[data-bia-count]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-bia-dialog]');
    const body = root.querySelector<HTMLElement>('[data-bia-dialog-body]');
    const openButton = root.querySelector<HTMLButtonElement>('[data-bia-open]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-bia-close]');

    if (!scroller || !count || !dialog || !body || !openButton || !closeButton) {
      throw new Error('Billing diagram controls are missing.');
    }

    const watch = (el: HTMLElement, label: HTMLElement | null) => {
      const slides = Array.from(el.querySelectorAll('svg'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || !label) return;
            const index = slides.indexOf(entry.target as SVGSVGElement);
            label.textContent = `${index + 1} / ${slides.length} · ${titles[index]}${index === 0 ? '. Scroll to explore.' : ''}`;
          });
        },
        { root: el, threshold: 0.6 },
      );
      slides.forEach((slide) => observer.observe(slide));
    };

    watch(scroller, count);
    openButton.addEventListener('click', () => {
      const clone = scroller.cloneNode(true) as HTMLElement;
      body.replaceChildren(clone);
      watch(clone, null);
      dialog.showModal();
      clone.focus();
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
