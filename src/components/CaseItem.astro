---
interface Props {
  title?: string;
  placeholder?: boolean;
}

const { title, placeholder = false } = Astro.props;
---

<div>
  {placeholder && <div class="mb-4 aspect-[1.4/1] w-full rounded-lg bg-placeholder" aria-hidden="true"></div>}
  {title && <h3 class="mb-1 text-base font-bold text-accent uppercase">{title}</h3>}
  <div class="space-y-3">
    <slot />
  </div>
</div>
