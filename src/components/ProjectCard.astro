---
// One project card: image placeholder, title and tag. Used by ProjectGrid.
interface Props {
  href: string;
  title: string;
  tag: string;
}
const { href, title, tag } = Astro.props;
---

<a href={href} class="group block" data-reveal>
  <div class="aspect-[4/3] overflow-hidden rounded-xl bg-placeholder transition-transform duration-500 group-hover:scale-[1.03]" aria-hidden="true">
  </div>
  <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-medium tracking-tight">{title}</h3>
    <span class="shrink-0 text-sm">{tag}</span>
  </div>
</a>
