---
// One project card: cover image, title, summary and a "View case study" link. Used by ProjectGrid.
interface Props {
  href: string;
  title: string;
  summary: string;
  coverImage: string;
  coverPosition?: string;
}
const { href, title, summary, coverImage, coverPosition = 'center' } = Astro.props;
const coverIsVideo = /\.(mp4|webm|mov)$/i.test(coverImage);
---

<a href={href} class="group block" data-reveal>
  <div class="aspect-[4/3] overflow-hidden rounded-xl bg-placeholder">
    {coverIsVideo ? (
      <video src={coverImage} autoplay muted loop playsinline aria-hidden="true" style={`object-position: ${coverPosition}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"></video>
    ) : (
      <img src={coverImage} alt="" loading="lazy" style={`object-position: ${coverPosition}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
    )}
  </div>
  <h3 class="type-card-title mt-4">{title}</h3>
  <!-- Same style as the home page description -->
  <p class="mt-2 text-base leading-relaxed text-pretty text-muted md:text-lg">{summary}</p>
  <!-- "View case study": the whole card is the link, so this is styled text (underline draws in and the arrow slides on hover) -->
  <span class="mt-5 inline-flex items-center gap-2 text-[15px] font-medium text-ink">
    <span class="link-underline">View case study</span>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
