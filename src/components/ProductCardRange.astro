---
// A grey panel showing the product card pattern across different products, side by side.
// Each card has a small label above it. The panel wraps tightly around the cards (no fixed shape), so the cards stay as large as possible.
// On phones one card shows at a time, with arrow buttons to step through them. From 640px up all cards show side by side,
// with the same Expand button as the other case study images (opens the cards larger in a pop-up).
// Usage in MDX: <ProductCardRange cards={[{ label: 'Broadband', src: '/images/...', alt: '...' }, ...]} caption="..." />
interface Card {
  label: string;
  src: string;
  alt: string;
}

interface Props {
  cards: Card[];
  caption?: string;
}

const { cards, caption } = Astro.props;
---

<!-- Phones: one card at a time with previous/next arrows. All cards share one grid cell, so the panel keeps the
     height of the tallest card and doesn't jump. From 640px up: all cards side by side, arrows hidden. -->
<figure class="group relative m-0" data-pcr>
  <div class="media-panel overflow-hidden rounded-lg border border-line px-[14%] py-6 sm:px-[6%] sm:py-[6%]">
    <ul class="pcr-list m-0 grid list-none items-start p-0 sm:gap-[4%]" style={`--cards: ${cards.length};`}>
      {cards.map((card, i) => (
        <li class="pcr-card m-0 p-0" data-active={i === 0 ? 'true' : 'false'} aria-label={`${i + 1} of ${cards.length}: ${card.label}`}>
          <p class="m-0 mb-2 text-sm font-bold text-ink">{card.label}</p>
          <img src={card.src} alt={card.alt} loading="lazy" class="block h-auto w-full drop-shadow-[0_1px_3px_rgba(0,0,0,0.12)]" />
        </li>
      ))}
    </ul>

    <!-- Arrows (phones only): same counter and chevron buttons as the O2 billing diagram -->
    <div class="mt-5 flex items-center justify-between gap-4 text-sm sm:hidden">
      <span data-pcr-count aria-live="polite" aria-atomic="true" class="text-muted">1 of {cards.length}</span>
      <div class="flex shrink-0 gap-2">
        <button type="button" data-pcr-prev aria-label="Previous card" aria-disabled="true" class="action-secondary inline-flex size-9 items-center justify-center rounded-full border aria-disabled:pointer-events-none aria-disabled:opacity-40">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>
        </button>
        <button type="button" data-pcr-next aria-label="Next card" aria-disabled="false" class="action-secondary inline-flex size-9 items-center justify-center rounded-full border aria-disabled:pointer-events-none aria-disabled:opacity-40">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Expand (640px and up): same button and pop-up style as the case study images -->
  <button
    type="button"
    data-pcr-open
    aria-haspopup="dialog"
    aria-label="Expand product cards"
    class="action-primary absolute top-3 right-3 hidden rounded-full px-3 py-1.5 text-sm font-semibold shadow transition-opacity sm:block sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100"
  >
    Expand
  </button>
  <dialog data-pcr-dialog aria-label="Expanded product cards" class="m-auto w-[min(96vw,1400px)] max-w-none rounded-lg bg-transparent p-0 backdrop:bg-black/80">
    <div class="rounded-lg bg-background p-3">
      <div class="mb-3 flex justify-end">
        <button type="button" data-pcr-close class="action-secondary rounded-full border px-4 py-1.5 text-sm">Close</button>
      </div>
      <div class="flex max-h-[calc(95vh-5rem)] items-start justify-center gap-6 overflow-auto rounded-lg media-panel p-6">
        {cards.map((card) => (
          <div class="shrink-0">
            <p class="m-0 mb-2 text-sm font-bold text-ink">{card.label}</p>
            <img src={card.src} alt="" class="block h-auto max-h-[calc(95vh-10rem)] w-auto max-w-[30vw] drop-shadow-[0_1px_3px_rgba(0,0,0,0.12)]" />
          </div>
        ))}
      </div>
    </div>
  </dialog>
  {caption && <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>}
</figure>

<style>
  /* Phones: stack every card in the same spot and show only the active one */
  .pcr-card {
    grid-area: 1 / 1;
  }
  .pcr-card[data-active='false'] {
    visibility: hidden;
  }

  /* From 640px up: one equal column per card, all visible */
  @media (min-width: 40rem) {
    .pcr-list {
      grid-template-columns: repeat(var(--cards), minmax(0, 1fr));
    }
    .pcr-card {
      grid-area: auto;
    }
    .pcr-card[data-active='false'] {
      visibility: visible;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pcr]').forEach((panel) => {
    const cards = Array.from(panel.querySelectorAll<HTMLElement>('.pcr-card'));
    const prev = panel.querySelector<HTMLButtonElement>('[data-pcr-prev]');
    const next = panel.querySelector<HTMLButtonElement>('[data-pcr-next]');
    const count = panel.querySelector<HTMLElement>('[data-pcr-count]');
    if (!prev || !next || !count) return;
    let current = 0;

    function show(index: number) {
      current = index;
      cards.forEach((card, i) => (card.dataset.active = String(i === current)));
      count!.textContent = `${current + 1} of ${cards.length}`;
      prev!.setAttribute('aria-disabled', String(current === 0));
      next!.setAttribute('aria-disabled', String(current === cards.length - 1));
    }

    const open = panel.querySelector<HTMLButtonElement>('[data-pcr-open]');
    const close = panel.querySelector<HTMLButtonElement>('[data-pcr-close]');
    const dialog = panel.querySelector<HTMLDialogElement>('[data-pcr-dialog]');
    if (open && close && dialog) {
      open.addEventListener('click', () => dialog.showModal());
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }

    prev.addEventListener('click', () => show(Math.max(0, current - 1)));
    next.addEventListener('click', () => show(Math.min(cards.length - 1, current + 1)));
    show(0);
  });
</script>
